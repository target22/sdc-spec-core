# Environment variables & credentials
.env
.env.*
*.pem
*.key
secrets/

# Real runtime contracts — the engine persists every uploaded customer
# contract to contracts/{contract_id}/ (see engine/contracts.py::persist_contract).
# Block everything under contracts/ EXCEPT the public domain-neutral
# reference pair, which is the one thing meant to ship in this repo.
contracts/*
!contracts/_reference/
!contracts/_reference/**

# DLQ log — AES-GCM encrypted at rest, but ciphertext of real customer
# payloads still doesn't belong in public git history.
logs/*
!logs/dlq_exceptions_REFERENCE.md
!logs/dlq_exceptions_template.log

# Python & runtime caches
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store

# Local backups / scratch dirs some editors or prior sessions may create
bak*/
*_backup/
bakup_20260827_SCE/
test_core_engine/